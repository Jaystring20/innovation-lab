# Super Admin Master Key (Development/Testing ONLY)
#
# Set this to enable the Super Admin "Master Key" account that bypasses all
# authentication and gives access to every page in the system.
#
# This is ONLY for local development and testing. DO NOT use in production.
#
# Example:
# NEXT_PUBLIC_SUPER_ADMIN_KEY=development-master-key
#
# Once set, you can access:
# - Dashboard: http://localhost:3000/dashboard
# - Store: http://localhost:3000/modules/store
# - Competition: http://localhost:3000/modules/competition
# - Judges: http://localhost:3000/modules/competition/judges
#
# No Supabase login required when this is set.

NEXT_PUBLIC_SUPER_ADMIN_KEY=development-master-key

# Supabase Configuration (optional - used when Super Admin Key is NOT set)
NEXT_PUBLIC_SUPABASE_URL=https://sctsrxuquhzdjjnlsqbm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Ci09czHBOmFNcIz-ib672g_79IixEfA
