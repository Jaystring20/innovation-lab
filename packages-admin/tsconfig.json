{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "incremental": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/app/*": [
        "./app/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/modules/*": [
        "./app/modules/*"
      ],
      "@/components/*": [
        "./app/components/*"
      ],
      "@/hooks/*": [
        "./app/hooks/*"
      ],
      "@/integrations/*": [
        "./app/integrations/*"
      ],
      "@/store/*": [
        "./app/store/*"
      ],
      "@/types/*": [
        "./app/types/*"
      ],
      "@repo/ui": [
        "../../packages/ui"
      ],
      "@repo/types": [
        "../../packages/types"
      ],
      "@repo/utils": [
        "../../packages/utils"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
